auto-install-peers=true
strict-peer-dependencies=false
shamefully-hoist=false

# The starter under `templates/` declares its `@fuaran-ui/*` dependencies as
# published semver ranges, not `workspace:*` — deliberately, so the directory
# can be copied out and `npm install`ed with no workspace around it
# (dev-scripts/check-starter-pins.mjs enforces exactly that, and also that each
# range tracks the workspace version). Those two rules together make the ranges
# name versions this repo has bumped but not yet PUBLISHED, which without this
# setting sends the root lockfile to the registry for packages this repo is the
# producer of: the lockfile then cannot be refreshed until a release tag runs,
# and the release workflow cannot run because it installs --frozen-lockfile.
# Linking workspace packages when the range is satisfied locally breaks that
# circle — the starter builds against the workspace it lives in, and its
# package.json still says what a consumer outside the workspace should install.
link-workspace-packages=true
