{
  "name": "@fuaran-ui/ops",
  "version": "0.4.0",
  "description": "Canonical-JSON codec (encoder + structural decoder) and tree-op apply engine for the Fuaran UI wire format — a conformant TypeScript host of the language-neutral contract in fuaran-dotnet/docs/WIRE_FORMAT.md, verified byte-for-byte against the workspace wire-format-fixtures corpus.",
  "keywords": [
    "fuaran",
    "ui",
    "ai",
    "wire-format",
    "json",
    "codec"
  ],
  "license": "Apache-2.0",
  "author": "Andrew J. Willshire <andrew@fuaran.com> (Diametrical Ltd)",
  "homepage": "https://github.com/fuaran-ui/fuaran-ts",
  "repository": {
    "type": "git",
    "url": "https://github.com/fuaran-ui/fuaran-ts.git",
    "directory": "packages/ops"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "lint": "tsc --noEmit -p tsconfig.test.json"
  },
  "peerDependencies": {
    "@fuaran-ui/schema": "workspace:^"
  },
  "devDependencies": {
    "@fuaran-ui/schema": "workspace:*",
    "@types/node": "^22.10.2",
    "fast-check": "^3.23.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
