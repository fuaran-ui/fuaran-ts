{
  "name": "@fuaran-ui/conformance",
  "version": "0.6.0",
  "description": "Third-party certification kit for the Fuaran UI wire format — runs any candidate implementation (via a small decode/encode adapter) over the bundled canonical fixture corpus and emits a per-leg pass/fail conformance report naming the corpus version. See CONFORMANCE.md for the certification procedure.",
  "keywords": [
    "fuaran",
    "ui",
    "ai",
    "wire-format",
    "conformance",
    "certification",
    "json"
  ],
  "license": "Apache-2.0",
  "author": "Andrew J. Willshire <andrew@fuaran.com> (Diametrical Ltd)",
  "homepage": "https://github.com/fuaran-ui/fuaran-ts",
  "repository": {
    "type": "git",
    "url": "https://github.com/fuaran-ui/fuaran-ts.git",
    "directory": "packages/conformance"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "bin": {
    "fuaran-conformance": "./dist/cli.js"
  },
  "files": [
    "dist",
    "corpus",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "lint": "tsc --noEmit -p tsconfig.test.json",
    "sync-corpus": "node scripts/sync-corpus.mjs",
    "check-corpus": "node scripts/sync-corpus.mjs --check"
  },
  "dependencies": {
    "ajv": "^8.17.1"
  },
  "devDependencies": {
    "@fuaran-ui/ops": "workspace:*",
    "@fuaran-ui/schema": "workspace:*",
    "@types/node": "^22.10.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
