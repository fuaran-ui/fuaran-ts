{
  "name": "@fuaran-ui/ui",
  "version": "0.1.0",
  "description": "Smart constructors + bounded-type kit + pre-emit validation for the Fuaran UI language contract — the ergonomic TypeScript author surface (fuaran.dashboard / fuaran.metric / …) over @fuaran-ui/schema. Mirrors the F# Fuaran.X module.",
  "keywords": [
    "fuaran",
    "ui",
    "ai",
    "typed-ui",
    "smart-constructors"
  ],
  "license": "Apache-2.0",
  "author": "Andrew J. Willshire <andrew@fuaran.com> (Diametrical Ltd)",
  "homepage": "https://github.com/fuaran-ui/fuaran-ts",
  "repository": {
    "type": "git",
    "url": "https://github.com/fuaran-ui/fuaran-ts.git",
    "directory": "packages/ui"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "lint": "tsc --noEmit -p tsconfig.test.json"
  },
  "peerDependencies": {
    "@fuaran-ui/schema": "workspace:^"
  },
  "devDependencies": {
    "@fuaran-ui/schema": "workspace:*"
  },
  "publishConfig": {
    "access": "public"
  }
}
