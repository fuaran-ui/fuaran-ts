<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <!-- A floating version resolves to whatever nuget.org serves TODAY, which is
         the pair a newcomer actually installs. See ../README.md, "Unpinned, on
         purpose"; NU1603/NU1604 are silenced because a float is the intent. -->
    <NoWarn>$(NoWarn);NU1603;NU1604</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Program.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Fuaran.UI" Version="*" />
  </ItemGroup>

</Project>
