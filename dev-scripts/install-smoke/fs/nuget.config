<?xml version="1.0" encoding="utf-8"?>
<!-- Every other source is CLEARED first, deliberately. A machine that has ever
     packed this family locally carries a folder feed in a parent nuget.config,
     and restoring through it would certify bits no stranger can obtain — the
     exact failure this smoke exists to rule out. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
