{
  "name": "fuaran-ui-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "Monorepo for the Fuaran UI language",
  "license": "Apache-2.0",
  "homepage": "https://github.com/fuaran-ui/fuaran-ts",
  "repository": {
    "type": "git",
    "url": "https://github.com/fuaran-ui/fuaran-ts.git"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build": "pnpm -r --filter \"./packages/*\" --filter \"./tools/*\" --filter \"./templates/*\" run build",
    "test": "pnpm -r --filter \"./packages/*\" --filter \"./tools/*\" run test && node dev-scripts/check-starter-pins.mjs",
    "typecheck": "pnpm -r --filter \"./packages/*\" --filter \"./tools/*\" run typecheck",
    "lint": "pnpm -r --filter \"./packages/*\" --filter \"./tools/*\" run lint",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "prettier": "^3.4.2",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
